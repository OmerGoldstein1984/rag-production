<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:body>
    <w:p>
      <w:r>
        <w:t>Acme Corp Organizational Structure</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Effective Date: January 1, 2024</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>This document outlines the hierarchical structure of Acme Corp as of Q1 2024.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Departments and Reporting Lines:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Chief Executive Officer (CEO): Jane Smith</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Chief Technology Officer (CTO): Robert Johnson</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Chief Financial Officer (CFO): Maria Garcia</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Vice President of Engineering: David Wilson</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Vice President of Marketing: Lisa Chen</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• Vice President of Sales: James Taylor</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Abbreviations Used:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• CEO: Chief Executive Officer</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• CTO: Chief Technology Officer</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• CFO: Chief Financial Officer</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• VP: Vice President</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Note: This version reflects the restructuring implemented in Q4 2023.</w:t>
      </w:r>
    </w:p>
  </w:body>
</w:document>