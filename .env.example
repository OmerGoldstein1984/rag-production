# Environment variables for RAG Academy

# LLM Provider Settings
# "nvidia" = production (NVIDIA NIM, OpenAI-compatible). "mock" = local dev/tests only.
LLM_PROVIDER=mock
# NVIDIA NIM (primary provider). Keys come ONLY from env vars — never commit them.
# RECOMMENDED: multiple keys, comma-separated, for rotation/failover:
NVIDIA_API_KEYS=your_nvidia_key_1_here,your_nvidia_key_2_here
# Single-key fallback (back-compat):
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT_S=60
NVIDIA_MAX_RETRIES=3

# Key-expiry alerting (key_monitor emails you before a key expires)
KEY_WARN_DAYS=14
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=alerts@example.com
SMTP_USE_TLS=true
ALERT_EMAIL_TO=you@example.com
# Local key-expiry registry (gitignored): data/key_registry.json
# Legacy placeholder providers (not implemented for real):
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Provider Settings
EMBEDDING_PROVIDER=mock
# For Sentence Transformers: EMBEDDING_PROVIDER=sentence_transformers

# Vector Store Settings
VECTOR_STORE_TYPE=simple  # Options: simple, faiss, pinecone, weaviate, etc.
VECTOR_STORE_PATH=./data/vector_store

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Evaluation Settings
EVALUATION_BATCH_SIZE=10
EVALUATION_TOP_K=5

# Miscellaneous
LOG_LEVEL=INFO
# Optional: if set, all API endpoints require 'Authorization: Bearer <API_TOKEN>'
API_TOKEN=