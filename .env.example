# Environment variables for RAG Academy

# LLM Provider Settings
LLM_PROVIDER=mock
# For OpenAI: LLM_PROVIDER=openai
# For Anthropic: LLM_PROVIDER=anthropic
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Provider Settings
EMBEDDING_PROVIDER=mock
# For Sentence Transformers: EMBEDDING_PROVIDER=sentence_transformers

# Vector Store Settings
VECTOR_STORE_TYPE=simple  # Options: simple, faiss, pinecone, weaviate, etc.
VECTOR_STORE_PATH=./data/vector_store

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Evaluation Settings
EVALUATION_BATCH_SIZE=10
EVALUATION_TOP_K=5

# Miscellaneous
LOG_LEVEL=INFO