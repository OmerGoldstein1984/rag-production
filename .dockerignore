# Never bake secrets or VCS into the image
.env
.env.*
!.env.example
.git
.gitignore

# Python / tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tooling state
.claude/
.claude-flow/
.swarm/
.mcp.json

# Runtime data (mounted as volumes at runtime, not baked in)
data/chroma_db/
data/embedding_cache/
data/key_registry.json
data/ingest_status.json
logs/
reports/
evaluation/
uploads/
runs/

# Docs/scripts not needed at runtime are fine to keep, but keep image lean:
*.md
!README.md
learn/
before_after_comparison.txt
chunking_comparison_results.txt
